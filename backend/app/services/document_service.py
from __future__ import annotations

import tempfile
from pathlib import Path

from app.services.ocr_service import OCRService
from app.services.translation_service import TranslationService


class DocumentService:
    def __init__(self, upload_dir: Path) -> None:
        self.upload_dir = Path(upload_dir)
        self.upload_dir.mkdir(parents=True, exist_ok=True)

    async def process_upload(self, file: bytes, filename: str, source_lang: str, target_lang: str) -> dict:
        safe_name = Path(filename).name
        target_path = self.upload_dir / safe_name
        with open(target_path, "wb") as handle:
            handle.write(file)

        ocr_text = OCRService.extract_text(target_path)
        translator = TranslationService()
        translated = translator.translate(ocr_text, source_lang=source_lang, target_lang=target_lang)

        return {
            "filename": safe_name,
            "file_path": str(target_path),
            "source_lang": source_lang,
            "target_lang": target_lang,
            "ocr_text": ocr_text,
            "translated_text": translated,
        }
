from __future__ import annotations

import os

from openai import OpenAI

from app.config import OPENAI_API_KEY, OPENAI_BASE_URL


class TranslationService:
    def __init__(self) -> None:
        self.client = OpenAI(api_key=OPENAI_API_KEY, base_url=OPENAI_BASE_URL) if OPENAI_API_KEY else None

    def translate(self, text: str, source_lang: str = "en", target_lang: str = "ko") -> str:
        if not text or not text.strip():
            return ""

        if self.client is None:
            return self._mock_translation(text, source_lang, target_lang)

        try:
            response = self.client.responses.create(
                model="gpt-4o-mini",
                input=[
                    {
                        "role": "system",
                        "content": "You are a careful translator of historical and handwritten missionary documents. Preserve meaning, names, and tone. Keep the output readable and historically faithful.",
                    },
                    {
                        "role": "user",
                        "content": f"Translate the following {source_lang} text into {target_lang}. Preserve names, places, and dated phrasing when possible.\n\n{text}",
                    },
                ],
            )
            return response.output_text.strip()
        except Exception:
            return self._mock_translation(text, source_lang, target_lang)

    @staticmethod
    def _mock_translation(text: str, source_lang: str, target_lang: str) -> str:
        # A resilient fallback used during local development and testing.
        prefix = f"[Local fallback translation: {source_lang} -> {target_lang}]\n"
        return prefix + text
